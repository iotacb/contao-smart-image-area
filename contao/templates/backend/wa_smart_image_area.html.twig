<div class="widget clr wa-image-area" data-wa-image-area data-worker-url="{{ workerUrl }}"
     data-loading="{{ 'waSmartImageArea.loading'|trans({}, 'contao_tl_files') }}"
     data-faces="{{ 'waSmartImageArea.faces'|trans({}, 'contao_tl_files') }}"
     data-objects="{{ 'waSmartImageArea.objects'|trans({}, 'contao_tl_files') }}"
     data-saliency="{{ 'waSmartImageArea.saliency'|trans({}, 'contao_tl_files') }}"
     data-fallback="{{ 'waSmartImageArea.fallback'|trans({}, 'contao_tl_files') }}"
     data-pending="{{ 'waSmartImageArea.pending'|trans({}, 'contao_tl_files') }}"
     data-unchanged="{{ 'waSmartImageArea.unchanged'|trans({}, 'contao_tl_files') }}"
     data-preserved="{{ 'waSmartImageArea.preserved'|trans({}, 'contao_tl_files') }}"
     data-edited="{{ 'waSmartImageArea.edited'|trans({}, 'contao_tl_files') }}"
     data-restored="{{ 'waSmartImageArea.restored'|trans({}, 'contao_tl_files') }}"
     data-discarded="{{ 'waSmartImageArea.discarded'|trans({}, 'contao_tl_files') }}"
     data-error="{{ 'waSmartImageArea.error'|trans({}, 'contao_tl_files') }}"
     data-restore="{{ 'waSmartImageArea.restore'|trans({}, 'contao_tl_files') }}"
     data-discard="{{ 'waSmartImageArea.discard'|trans({}, 'contao_tl_files') }}"
     data-badge="{{ 'waSmartImageArea.badge'|trans({}, 'contao_tl_files') }}">
    <button type="button" class="tl_submit" data-suggest>{{ 'waSmartImageArea.suggest'|trans({}, 'contao_tl_files') }}</button>
    <button type="button" class="tl_submit" data-undo hidden>{{ 'waSmartImageArea.restore'|trans({}, 'contao_tl_files') }}</button>
    <p class="tl_help" role="status" aria-live="polite" data-status></p>
    <p class="tl_help">{{ 'waSmartImageArea.help'|trans({}, 'contao_tl_files') }}</p>
</div>
